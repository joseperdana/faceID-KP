# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Auth ---
ADMIN_PASSWORD=
SECRET_KEY=

# --- Geofence ---
# Kiosk hanya memvalidasi lokasi saat ini bernilai true.
ENABLE_GEOFENCE=false

# --- Observability ---
SENTRY_DSN=
# Memisahkan error laptop dev dari kiosk produksi. Isi "production" di VPS.
ENVIRONMENT=development
# Diisi otomatis oleh script deploy (git sha). Kalau kosong, dibaca dari git.
RELEASE=
# Hanya data performa yang di-sample; error tetap dikirim 100%.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1


# --- Akses registrasi kios (opsional) ---
# Token untuk membuka /register di perangkat panitia tanpa memberi akses dashboard.
# Kosongkan untuk kembali ke perilaku lama (hanya admin).
REGISTER_TOKEN=

# --- OBS (skrip scripts/obs/obs_director.py, hanya di Mac operator) ---
# Password OBS WebSocket (OBS: Tools -> WebSocket Server Settings).
# Password lama pernah tertulis di kode repo publik ini: wajib diganti di OBS.
# Skrip tidak membaca .env — export di shell sebelum menjalankannya.
OBS_WS_PASSWORD=
