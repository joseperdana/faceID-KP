# FaceID-KP configuration
#
#   cp .env.example .env    then fill every REQUIRED value.
#
# The application refuses to start if anything required is missing, and reports
# all of them at once. Variable names here match what the code actually reads —
# an earlier deployment guide named variables that no module ever looked up, so
# following it produced a server that crash-looped on boot.
#
# Never commit the filled-in .env. It is listed in .gitignore.

# --- REQUIRED: database ----------------------------------------------------
# Use the service_role key, not the anon key. migrations/001_init.sql enables
# Row Level Security and revokes anon access, so the backend needs a key that
# bypasses RLS. This key is server-side only and never reaches a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# --- REQUIRED: authentication ----------------------------------------------
# JWT signing key. Minimum 32 characters. Generate a fresh one:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this immediately invalidates every existing admin session.
SECRET_KEY=

# Admin password, stored as a bcrypt hash. Generate with:
#   python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
# Legacy plaintext fallback. Still accepted so an existing deployment keeps
# working, but the app warns on every boot. Remove it once the hash is set.
# ADMIN_PASSWORD=

# Shared secret for the kiosk tablet. Gates registration, manual check-in and
# member search so they are not open to the internet. Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Enrol a device once: sign in as admin on the tablet, then open /kiosk/enroll.
KIOSK_TOKEN=

# --- REQUIRED when geofencing is on ----------------------------------------
# VERIFY THESE ON A MAP BEFORE SETTING THEM.
# The repository previously carried two different hardcoded coordinate pairs
# about 965 m apart, so neither can be trusted. Wrong coordinates reject every
# member standing at the kiosk. There is deliberately no default.
#
# Note that these coordinates are supplied by the browser and cannot be verified
# by the server: geofencing prevents accidental check-ins from home, it does not
# prevent deliberate spoofing. Do not treat it as a security control.
ENABLE_GEOFENCE=true
CHURCH_LAT=
CHURCH_LNG=
GEOFENCE_RADIUS_METERS=200

# --- Optional: sessions and cookies ----------------------------------------
SESSION_HOURS=8
KIOSK_TOKEN_DAYS=365
# Set to false ONLY for local http development.
COOKIE_SECURE=true

# --- Optional: face recognition --------------------------------------------
# The duplicate threshold must be LOWER than (or equal to) the match threshold.
# When it was higher, a face similar enough to be matched at check-in could
# still pass registration, and every later scan logged the wrong person.
FACE_MATCH_THRESHOLD=0.42
FACE_DUPLICATE_THRESHOLD=0.35
# Minimum gap to the runner-up. Below this the match is treated as ambiguous
# (siblings, twins) and refused rather than guessed.
FACE_MATCH_MARGIN=0.05

# buffalo_sc is far lighter than buffalo_l and adequate for ~130 members on a
# 2 GB VPS. Lowering FACE_DET_SIZE to 320 roughly quarters detection cost.
FACE_MODEL_NAME=buffalo_l
FACE_DET_SIZE=640
# Only enable if match_faces() uses cosine distance (migrations/001_init.sql
# does). Leave false for a hand-provisioned database.
FACE_NORMALIZE_EMBEDDINGS=false

# --- Optional: upload limits -----------------------------------------------
MAX_IMAGE_BYTES=5242880
MAX_REGISTER_FILES=8
MAX_IMAGE_PIXELS=12000000
PHOTOBOOTH_MAX_BYTES=8388608
PHOTOBOOTH_RETENTION_DAYS=14

# --- Optional: rate limits -------------------------------------------------
# Set a Redis URI when running more than one worker; the in-memory default is
# per-process, so N workers multiply every limit by N.
# RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379
RATE_LIMIT_RECOGNIZE=240/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SEARCH=120/minute
RATE_LIMIT_CHECKIN=120/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_PHOTOBOOTH=10/minute

# --- Optional: observability -----------------------------------------------
# 100% traces plus 100% profiling burned CPU that face inference needed and
# exhausted the free event quota within a couple of events.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# --- Optional: misc --------------------------------------------------------
ENVIRONMENT=production
# Public URL used in photobooth QR codes. Without it the server guesses its LAN
# address, which is wrong behind a domain.
# PHOTOBOOTH_BASE_URL=https://absen.example.org
